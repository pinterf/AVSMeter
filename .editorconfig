root = true

[*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{cpp,h,rc}]
end_of_line = crlf

# Third-party headers: keep upstream formatting untouched.
[source/{avs_headers,cpuid}/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
end_of_line = unset
