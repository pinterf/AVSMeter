{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux, GCC, Release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux, Clang, Release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "linux-aarch64-gcc",
      "displayName": "Linux aarch64 cross, GCC, Release",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu-gcc.cmake"
    },
    {
      "name": "linux-aarch64-clang",
      "displayName": "Linux aarch64 cross, Clang + lld, Release",
      "inherits": "linux-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/aarch64-linux-gnu-clang.cmake"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs64",
      "displayName": "Windows, Visual Studio 2026, x64",
      "inherits": "windows-base",
      "architecture": "x64"
    },
    {
      "name": "vs32",
      "displayName": "Windows, Visual Studio 2026, Win32",
      "inherits": "windows-base",
      "architecture": "Win32"
    }
  ],
  "buildPresets": [
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "linux-aarch64-gcc", "configurePreset": "linux-aarch64-gcc" },
    { "name": "linux-aarch64-clang", "configurePreset": "linux-aarch64-clang" },
    { "name": "vs64", "configurePreset": "vs64", "configuration": "Release" },
    { "name": "vs32", "configurePreset": "vs32", "configuration": "Release" }
  ]
}
